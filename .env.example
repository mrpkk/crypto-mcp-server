# Crypto MCP Server Configuration
# Copy to .env and fill in your keys

# Primary AI provider — GitHub token (already set from gh auth)
GITHUB_TOKEN=ghp_your_token_here

# Fallback AI provider (if GitHub token exhausted)
MISTRAL_API_KEY=your_mistral_api_key

# Optional — for on-chain data (get free at alchemy.com, infura.io)
ALCHEMY_API_KEY=
INFURA_PROJECT_ID=
ETHERSCAN_API_KEY=

# For smart contract deployment
DEPLOYER_PRIVATE_KEY=
